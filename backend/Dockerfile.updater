FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src
COPY backend/Directory.Build.props backend/Household.slnx ./
COPY backend/src/Household.Updater/Household.Updater.csproj src/Household.Updater/
RUN dotnet restore src/Household.Updater/Household.Updater.csproj
COPY backend/src/Household.Updater/ src/Household.Updater/
RUN dotnet publish src/Household.Updater/Household.Updater.csproj --no-restore --configuration Release --output /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine
RUN apk add --no-cache docker-cli ca-certificates wget
COPY --from=build /app /app
WORKDIR /app
EXPOSE 8091
ENTRYPOINT ["dotnet", "Household.Updater.dll"]
