      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(dotnet_process_memory_working_set_bytes{job=\"$service\"})",
          "legendFormat": "__auto",
          "refId": "A"
