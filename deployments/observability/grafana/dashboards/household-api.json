    {
      "type": "timeseries",
      "title": "CPU",
      "description": "Anteil der CPU-Kerne, den der API-Prozess nutzt.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(dotnet_process_cpu_time_seconds_total{job=\"$service\"}[$__rate_interval])) / max(dotnet_process_cpu_count{job=\"$service\"})",
