# Copy this file to deployments/.env before running Docker Compose:
#   cp deployments/.env.example deployments/.env
#
# Replace every "change-me" value before using this on a real server.

PROJECT_NAME=household
HOUSEHOLD_VERSION=stable
HOUSEHOLD_IMAGE_OWNER=kratofl

# Web
HOUSEHOLD_WEB_PORT=3000

# API
HOUSEHOLD_API_SERVER_PORT=8090
HOUSEHOLD_API_SERVER_TIMEOUT_READ=5s
HOUSEHOLD_API_SERVER_TIMEOUT_WRITE=10s
HOUSEHOLD_API_SERVER_TIMEOUT_IDLE=60s
# HOUSEHOLD_API_SERVER_DEBUG=false
# HOUSEHOLD_API_DB_DEBUG=false

# Postgres
HOUSEHOLD_DB_DATABASE=household
HOUSEHOLD_DB_USER=household
HOUSEHOLD_DB_PASSWORD=change-me-long-random-database-password
HOUSEHOLD_DB_PORT=5432

# Logging
HOUSEHOLD_LOG_LEVEL=info
# HOUSEHOLD_LOG_FILE_ENABLED=false

# First admin seed.
# For first boot, set HOUSEHOLD_SEED_DEMO_USER=true and use a strong password.
# After creating or changing the admin account, set it back to false and restart.
HOUSEHOLD_SEED_DEMO_USER=false
HOUSEHOLD_SEED_DEMO_USER_NAME=admin
HOUSEHOLD_SEED_DEMO_USER_EMAIL=admin@household.local
HOUSEHOLD_SEED_DEMO_USER_PASSWORD=change-me-before-first-boot

# In-app updates.
# The updater token protects the internal updater sidecar. Use a long random value.
HOUSEHOLD_UPDATES_GITHUB_REPOSITORY=kratofl/household
HOUSEHOLD_UPDATER_TOKEN=change-me-long-random-updater-token
HOUSEHOLD_UPDATES_TIMEOUT=15s

# Optional observability profile.
GRAFANA_IMAGE=grafana/grafana:12.4.3
LOKI_IMAGE=grafana/loki:3.5.12
ALLOY_IMAGE=grafana/alloy:v1.16.1
GRAFANA_PORT=3001
LOKI_PORT=3100
ALLOY_PORT=12345
